      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Client-provided images are typically organized into subfolders by project or date, but retouched images often end up flat in a single folder. Use this tool to match by filename and restore the original folder structure with one click."
          }
        },
        "zh-Hans" : {
